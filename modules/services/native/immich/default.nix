# Immich
#
# ### Description
# Immich is a self-hosted photo and video management solution to easily back up, organize and
# manage your photos on your own server. Immich helps you browse, search and organize your photos
# and videos with ease, without sacrificing your privacy.
#
# ### Deployment notes
# 1. Wraps upstream's `services.immich`, taken from `nixpkgs-unstable` (module below, package via
#    the `immich` override in modules/nixpkgs.nix) so the two always move together. Upstream
#    provisions everything else: the local PostgreSQL with pgvector + VectorChord (and the reindex
#    on VectorChord updates), a dedicated Redis, both over Unix sockets, so there's no DB password.
# 2. With `caddy` (the default) Immich listens on `127.0.0.1:<port>` only and is reached through
#    Caddy's TLS at `<subdomain>.<zone>` for each `subdomains` entry, on the primary zone or, with
#    `whichDomains = "all"`, on every zone in `domains`. With `caddy = false` it listens on all
#    interfaces and `port` is opened on the LAN instead - plain HTTP.
# 3. Pangolin: same as Vaultwarden (modules/services/native/vaultwarden.nix note 5) - serve the
#    zone with `whichDomains = "all"`, list `immich` (public) and `immich-vpn` (private) in Newt's
#    `pangolin.resources`, and give the private one its own entry in `subdomains`. Public resources
#    sit behind Pangolin's SSO, which the mobile app can't get through, so point the app at the
#    `immich-vpn` name over the Pangolin client (or the LAN name via the app's automatic URL
#    switching) and keep the public name for browsers.
# 4. System settings stay in the admin UI (upstream `settings = null`). Setting
#    `services.immich.settings` makes Immich read its whole config from a file and locks the UI.
#    In the UI set Server > External domain to `https://<first subdomain>.<primary domain>` for
#    share links, and with `cuda` set Video Transcoding > Hardware Acceleration to NVENC.
# 5. The first account created through the web UI becomes the admin.
# 6. `cuda` runs machine learning (smart search, faces, OCR) on onnxruntime's CUDA provider and
#    gives both services the NVIDIA device nodes for NVENC transcoding. Needs a Turing or newer
#    card (cuDNN 9.11+ dropped Maxwell/Pascal/Volta) on the current, non-legacy driver. onnxruntime
#    with CUDA isn't in the public binary cache, so the first build compiles it locally (long -
#    set `cudaCapabilities` to just your card's to cut it to roughly a tenth).
#    Check it took with `journalctl -u immich-machine-learning | rg -i CUDAExecutionProvider`
#    while a job runs and `nvidia-smi` showing the python process.
# 7. `<backupDir>/immich` gets a nightly copy at `backupTime` (default 03:00) of `mediaLocation`:
#    originals (`library`, `upload`), `profile` and Immich's own database dumps (`backups`, written
#    daily at 02:00 by Immich itself, keeping the last 14). `thumbs` and `encoded-video` are
#    regenerable, so only their `.immich` marker files are copied. Each run overwrites the last and
#    it stays on this disk, so pair it with something that keeps history off-box.
#    `backupDir` is forwarded from `host.backupDir`; `null` (the default) disables backups.
#
# ### Backup process
# #### Trigger backup
#  sudo systemctl start backup-immich
#
# #### Restore
# The backup share doesn't preserve ownership or modes, so the restore copies content only and
# then resets ownership recursively. Upstream's restore guide covers loading the DB dump:
# https://docs.immich.app/administration/backup-and-restore
#
# 1. Stop the services
#    sudo systemctl stop immich-server immich-machine-learning
#
# 2. Restore the media
#    sudo rsync -rlt <backupDir>/immich/ /var/lib/immich/
#
# 3. Reset ownership
#    sudo chown -R immich:immich /var/lib/immich
#
# 4. Restore the newest `backups/immich-db-backup-*.sql.gz` into the `immich` database, then start
#    the services (`thumbs`/`encoded-video` are regenerated by the admin UI's Jobs page)
#    sudo systemctl start immich-server immich-machine-learning
# --------------------------------------------------------------------------------------------------
{ config, lib, pkgs, inputs, f, ... }: with lib.types;
let
  cfg = config.services.native.immich;
  gpu = config.devices.gpu.nvidia;
  mediaLocation = config.services.immich.mediaLocation;
in
{
  # Swap the stable upstream module for unstable's so it always matches the unstable package.
  # Unconditional by necessity (imports can't depend on config) - it only replaces the option
  # declarations, nothing is enabled until `services.immich.enable`.
  disabledModules = [ "services/web-apps/immich.nix" ];
  imports = [ "${inputs.nixpkgs-unstable}/nixos/modules/services/web-apps/immich.nix" ];

  options = {
    # `domains`/`whichDomains`: which Caddy zones it's served on, see modules/types/caddy_domains.nix
    services.native.immich = (import ../../../types/caddy_domains.nix { inherit lib; }) // {
      enable = lib.mkEnableOption "Install and configure Immich server";

      port = lib.mkOption {
        type = types.port;
        default = 2283;
        description = "Port the Immich web/API server listens on.";
      };

      caddy = lib.mkOption {
        type = types.bool;
        default = true;
        description = ''
          Front Immich with `services.native.caddy` (enabled by default along with it) at
          `<subdomain>.<zone>` for each `subdomains` entry on each zone picked by `whichDomains`.
          When `false`, Immich listens on all interfaces and `port` is opened on the LAN instead.
        '';
      };

      subdomains = lib.mkOption {
        type = listOf types.str;
        default = [ "immich" ];
        example = [ "immich" "immich-vpn" ];
        description = ''
          Subdomains Immich is served at when `caddy` is enabled - every entry gets its own hostname
          matcher on each served zone's wildcard block, all routed to the same backend. List more
          than one to give it a distinct name for a Pangolin private resource (see deployment
          note 3 above).
        '';
      };

      cuda = lib.mkOption {
        type = types.bool;
        default = false;
        description = ''
          Run machine learning on the NVIDIA GPU via onnxruntime's CUDA provider and give the
          server the device nodes for NVENC transcoding. Requires a Turing or newer card on the
          current driver - see deployment note 6 above.
        '';
      };

      cudaCapabilities = lib.mkOption {
        type = types.listOf types.str;
        default = [ ];
        example = [ "7.5" ];
        description = ''
          CUDA compute capabilities to compile onnxruntime for, e.g. `[ "7.5" ]` for a GTX 16xx /
          RTX 20xx. Empty uses nixpkgs' default, which targets every supported generation and
          multiplies the compile time. PTX for the last entry is kept, so newer cards still work
          (JIT-compiled at first start).
        '';
      };

      backupDir = lib.mkOption {
        type = types.nullOr types.str;
        default = null;
        example = "/mnt/Apps/homelab";
        description = ''
          Parent directory to copy `mediaLocation` into nightly, as `<backupDir>/immich`,
          overwriting the previous run - see deployment note 7 above. Forwarded from
          `host.backupDir` by `modules/default.nix`. Must be outside `mediaLocation`. `null`
          disables backups.
        '';
      };

      backupTime = lib.mkOption {
        type = types.str;
        default = "03:00";
        example = "Sun 02:30";
        description = ''
          When the nightly `backupDir` copy runs, as a systemd `OnCalendar` expression. Keep it
          after Immich's own 02:00 database dump so each copy carries that night's dump.
        '';
      };
    };
  };

  config = lib.mkIf cfg.enable (lib.mkMerge [
    {
      # - host: Immich's default "localhost" can resolve to ::1 only, Caddy proxies to 127.0.0.1
      # - IMMICH_TRUSTED_PROXIES: only Caddy over loopback may set X-Forwarded-For. Without Caddy
      #   clients connect directly, so no proxy is trusted
      services.immich = {
        enable = true;
        port = cfg.port;
        host = if cfg.caddy then "127.0.0.1" else "0.0.0.0";
        openFirewall = !cfg.caddy;
        environment.IMMICH_TRUSTED_PROXIES = lib.mkIf cfg.caddy "127.0.0.1";
      };
    }

    (lib.mkIf cfg.cuda {
      assertions = [
        { assertion = gpu.enable && !(gpu.legacy580 || gpu.legacy470 || gpu.legacy390 || gpu.legacy340);
          message = "services.native.immich.cuda requires 'devices.gpu.nvidia.enable' on the current (non-legacy) driver with a Turing or newer card"; }
      ];

      services.immich.package = pkgs.callPackage ./package.nix { inherit (cfg) cudaCapabilities; };

      # Upstream's default `[ ]` sets PrivateDevices, hiding the GPU from both services
      services.immich.accelerationDevices = [
        "/dev/nvidia0"
        "/dev/nvidiactl"
        "/dev/nvidia-modeset"
        "/dev/nvidia-uvm"
        "/dev/nvidia-uvm-tools"
      ];
      users.users.immich.extraGroups = [ "video" "render" ];
    })

    # Nightly copy of mediaLocation, see deployment note 7
    # - Runs as root: the CIFS backup share forces its own owner and modes, and -rlt skips the
    #   ownership/permission sync it would refuse anyway
    # - No stop needed: originals are write-once and the DB is covered by Immich's own dump
    # - No wantedBy on the service itself so it never fires at boot against an unmounted share
    (lib.mkIf (cfg.backupDir != null) (let
      backupDir = "${cfg.backupDir}/immich";
    in {
      assertions = [
        { assertion = !(lib.hasPrefix "${mediaLocation}/" "${backupDir}/");
          message = "services.native.immich.backupDir must be outside ${mediaLocation}"; }
      ];

      # Have services.native.alerts watch this backup
      services.native.alerts.enable = lib.mkDefault true;
      services.native.alerts.backup.services = [ "immich" ];

      systemd.services.backup-immich = {
        description = "Backup Immich media and database dumps";
        path = [ pkgs.rsync ];
        serviceConfig.Type = "oneshot";
        script = ''
          set -euo pipefail
          mkdir -p ${backupDir}
          rsync -rlt --delete \
            --include=/thumbs/.immich --exclude='/thumbs/*' \
            --include=/encoded-video/.immich --exclude='/encoded-video/*' \
            ${mediaLocation}/ ${backupDir}/
        '';
      };

      systemd.timers.backup-immich = {
        description = "Backup Immich nightly";
        wantedBy = [ "timers.target" ];
        timerConfig = {
          OnCalendar = cfg.backupTime;
          Persistent = true;
        };
      };
    }))

    # Add a caddy proxy config per subdomain for DNS subdomain resolution
    (lib.mkIf cfg.caddy {
      assertions = [
        { assertion = cfg.subdomains != [ ];
          message = "services.native.immich with caddy requires at least one 'subdomains' entry"; }
        (f.caddyDomainsAssert "native.immich" cfg)
      ];

      services.native.caddy.enable = lib.mkDefault true;
      services.native.caddy.domains = f.caddyProxies cfg (map (sub: { subdomain = sub; inherit (cfg) port; }) cfg.subdomains);
    })
  ]);
}
