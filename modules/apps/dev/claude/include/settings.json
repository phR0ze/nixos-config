{
  "permissions": {
    "allow": [
      "Skill",
      "WebFetch",
      "WebSearch",

      "Read(~/.claude/**)",
      "Read(./**)",
      "Bash(ls -la ./ *)",
      "Bash(ls -la ~/.claude/*)",

      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(realpath *)",
      "Bash(pwd)",
      "Bash(hostname)",
      "Bash(uname *)",
      "Bash(echo *)",

      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(git stash list:*)",

      "Bash(find . *)",
      "Bash(mkdir ~/.claude/*)",
      "Bash(mkdir -p ~/.claude/*)",
      "Bash(mkdir ./*)",

      "Bash(nix develop *)",
      "Bash(nix eval *)",
      "Bash(nix flake show *)",
      "Bash(nix flake metadata *)",
      "Bash(nix search *)",
      "Bash(nix-instantiate --parse *)",

      "Bash(journalctl *)",
      "Bash(systemctl cat *)",
      "Bash(systemctl list-units *)",
      "Bash(systemctl status *)"
    ],
    "deny": [
      "Read(../*)",
      "Read(./../*)",
      "Bash(ls -la ./../ *)",
      "Bash(find / *)",
      "Bash(find .. *)",
      "Bash(mkdir ./../*)",
      "Bash(mkdir ../*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "effortLevel": "medium",
  "skipAutoPermissionPrompt": true,
  "vim": true
}
