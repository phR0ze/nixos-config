#!/usr/bin/env bash

# Usage for the run command and its sub commands
# --------------------------------------------------------------------------------------------------
run::usage()
{
    cat <<USAGE
Usage:
  run [COMMAND] [ARGS...] [OPTIONS]

Options:
  -h, --help            Print out usage
  -c, --clean           Delete the VM before running to trigger a build first

Commands:
  vm [NAME]             Run the given VM or vm-test by default
  iso                   Create a VM and boot from the ISO located at result/iso/*.iso
USAGE

    log::ln "\nExamples:"
    log::subln "Run a clean test VM: ${green}./${SCRIPT} run vm -c${none}"
    log::subln "Run the prod1 VM: ${green}./${SCRIPT} run vm prod1${none}"
    log::subln "Run a new VM to test the ISO: ${green}./${SCRIPT} run iso -c${none}"
    echo
    exit
}


# Parse the run commands and execute
# --------------------------------------------------------------------------------------------------
run::run()
{
    utils::help "$@" "run::usage"

    local cmd="${ARGS[0]}" && unset 'ARGS[0]'
    case "$cmd" in
        vm) run::vm "${ARGS[@]}" ;;
        iso) run::iso "${ARGS[@]}" ;;
        *) log::error "Invalid run command: ${cyan}${command}${none}"; run::usage ;;
    esac
}
 
# Run the test vm
# - $1 - optional host name to target
# --------------------------------------------------------------------------------------------------
run::vm()
{
    core::preamble

    # Determine the kind of VM being run i.e. either direct path to an isolated VM or a keyword to
    # map into a host dependent VM.
    local host="$1"

    # Local isolated VM
    if [[ -d "${host}" ]]; then
        log::header1 "Running VM ${cyan}${host}${none}"

        # Launch QEMU with performance optimizations:
        # - machine q35: Modern PCIe-based machine type
        # - enable-kvm: Hardware acceleration
        # - virtio-vga-gl & gtk,gl=on: 3D acceleration
        # - virtio-tablet-pci: Absolute mouse coordinates (no lag)
        $SUDO qemu-system-x86_64 \
            -name NixOS \
            -machine q35 \
            -enable-kvm \
            -m 4G -cpu host -smp 4 \
            -nic user \
            -device virtio-vga-gl \
            -display gtk,gl=on \
            -device virtio-tablet-pci \
            -hda "${host}/nixos.qcow2"
    else
        # Default to the test vm if not given
        [[ "$host" == "" ]] && host="test"
        HOST="vm-${host}"

        # Target includes the prefix path
        TARGET="hosts/$HOST"

        log::header1 "Running VM ${cyan}${TARGET}${none}"

        # Optionally clean first
        if [[ $CLEAN -eq 1 ]]; then
            log::ls "Cleaning ${cyan}${HOST}${none}"
            $SUDO rm -rf "${CONFIG_DIR}/vms/${HOST}"
        fi

        # Named explicitly rather than via `find .../result/bin | head -n1` - that glob also
        # matches the macvtap-up/macvtap-down scripts linked alongside `run` for macvtap guests,
        # and `find`'s ordering between them isn't guaranteed to put `run` first.
        local runner
        runner="${CONFIG_DIR}/vms/${HOST}/result/bin/run"

        # Build and install if needed
        if [[ ! -f "$runner" ]]; then

            # Fallback: boot a disk image produced by 'clu run iso' + 'clu install' directly,
            # without a Nix VM rebuild.  This is the path used after 'clu conv <src> <name>'.
            local disk="${CONFIG_DIR}/vms/${HOST}/nixos.qcow2"
            if [[ -f "$disk" ]]; then
                log::ls "Booting ${cyan}${HOST}${none} from disk image"
                $SUDO qemu-system-x86_64 \
                    -name NixOS \
                    -machine q35 \
                    -enable-kvm \
                    -m 4G -cpu host -smp 4 \
                    -nic user \
                    -device virtio-vga-gl \
                    -display gtk,gl=on \
                    -device virtio-tablet-pci \
                    -hda "$disk"
                return
            fi

            NO_PREAMBLE=1 && build::vm $HOST
            flake::restore
        fi

        # Re-seed on every run: the key is only ever written to the VM dir, never the qcow2, so a
        # VM built before this existed (or one whose dir was hand-cleaned) still needs it.
        build::seed_vm_key "$HOST"

        # Macvtap guests link macvtap-up/-down alongside run (guest.nix, only when the guest has a
        # `type = "macvtap"` interface). Creating/destroying that interface needs root, so bracket
        # the (unprivileged) run with sudo'd up/down - down via a trap so it still fires on Ctrl-C
        # or a qemu crash.
        local macvtap_up="${CONFIG_DIR}/vms/${HOST}/result/bin/macvtap-up"
        local macvtap_down="${CONFIG_DIR}/vms/${HOST}/result/bin/macvtap-down"
        if [[ -f "$macvtap_up" ]]; then
            $SUDO "$macvtap_up"
            trap "$SUDO '$macvtap_down'" EXIT
        fi

        # The generated run script (scripts-run.nix) resolves its VM state dir as a plain
        # relative "${guest.hostname}" (i.e. "$HOST") under the caller's cwd - cd into vms/ so
        # that resolves to vms/$HOST rather than the flake root.
        log::ls "Running ${cyan}${runner}${none}"
        utils::run pushd "${CONFIG_DIR}/vms"
        $runner
        utils::run popd
    fi
}
 
# Create a new VM and boot from the ISO
# --------------------------------------------------------------------------------------------------
run::iso()
{
    core::preamble

    HOST="vm-iso"
    log::header1 "Boot VM with ${cyan}result/iso/*.iso${none}"

    # Check that the ISO exists
    local iso="${CONFIG_DIR}/result/iso/$(ls ${CONFIG_DIR}/result/iso)"
    log::ls -n "Locating iso..."
    if [ -f "$iso" ]; then
        log::status
        log::subln3 "${cyan}$iso${none}"
    else
        log::status 1
        log::fatal "ISO doesn't exist yet run: ./clu build iso"
    fi

    # Optionally clean first
    if [[ $CLEAN -eq 1 ]]; then
        log::ls "Cleaning ${cyan}${HOST}${none}"
        $SUDO rm -rf "${CONFIG_DIR}/vms/${HOST}"
    fi

    # Create the vm directory and volume if needed
    log::ls "Launching VM with ISO"
    $SUDO mkdir -p "${CONFIG_DIR}/vms/${HOST}"
    if [ ! -d "${CONFIG_DIR}/vms/${HOST}" ]; then
        log::subln3 "${cyan}$iso${none}"
    fi
    utils::run pushd "${CONFIG_DIR}/vms/${HOST}"

    # Create the volume if needed
    local vol="nixos.qcow2"
    if [ ! -f "$vol" ]; then
        $SUDO qemu-img create -f qcow2 $vol 40G
    fi
    
    # Run the VM using the ISO to boot from
    # Launch QEMU with performance optimizations:
    # - machine q35: Modern PCIe-based machine type
    # - enable-kvm: Hardware acceleration
    # - virtio-vga-gl & gtk,gl=on: 3D acceleration
    # - virtio-tablet-pci: Absolute mouse coordinates (no lag)
    $SUDO qemu-system-x86_64 \
        -name NixOS \
        -machine q35 \
        -enable-kvm \
        -m 4G -cpu host -smp 4 \
        -nic user \
        -device virtio-vga-gl \
        -display gtk,gl=on \
        -device virtio-tablet-pci \
        -hda $vol \
        -cdrom "$iso"
    utils::run popd
}
