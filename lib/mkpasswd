#!/usr/bin/env bash
#set -x

# Generate a sha-512 crypt hash suitable for a secrets.enc.yaml `passwordHash` value
#
# ### Background
# `modules/system/users.nix` and `layers/console/vps.nix` both expect `user/passwordHash` in a
# host's secrets.enc.yaml to already be a `mkpasswd -m sha-512` hash (consumed via
# `hashedPasswordFile`/`passwordHashSecretRef`, never the plaintext password) - this wraps that
# call so the correct method/args don't have to be remembered each time.
# --------------------------------------------------------------------------------------------------

# Usage for the mkpasswd command
# --------------------------------------------------------------------------------------------------
mkpasswd::usage()
{
    cat <<USAGE
Usage:
  mkpasswd PASSWORD [OPTIONS]

Options:
  -h, --help            Print out usage

Arguments:
  PASSWORD              Plaintext password to hash
USAGE

    log::ln "\nExamples:"
    log::subln "Hash a password: ${green}./${SCRIPT} mkpasswd vpsadmin${none}"
    echo
    exit
}

# Parse the mkpasswd command and execute
# - $1 - plaintext password to hash
# --------------------------------------------------------------------------------------------------
mkpasswd::run()
{
    utils::help "$@" "mkpasswd::usage"

    mkpasswd -m sha-512 "$1"
}
