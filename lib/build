#!/usr/bin/env bash
#set -x

# Build code
# 
# ## Features
# - The ISO build target is 'develop' by default which is the heaviest profile and builds on all the 
#   other profiles which means that all packages will be included on the ISO. By changing the ISO 
#   target to something smaller like 'light' we can create a smaller ISO with less packages included.
#
# - VM hard disk can be tiny e.g. 1 GiB as all the predefined apps and configs are in the host's nix 
#   store and mounted readonly in the VM.
# --------------------------------------------------------------------------------------------------

# Usage for the build command and its sub commands
# --------------------------------------------------------------------------------------------------
build::usage()
{
    cat <<USAGE
Usage:
  build [COMMAND] [ARGS...] [OPTIONS] 

Options:
  -h, --help            Print out usage
  -c, --clean           Delete the VM before running to trigger a build first
  --impure              Pass impure into the system update

Commands:
  iso [LAYER]           Build the installable ISO with an optional layer override
  vm [HOST]             Build the given VM host or the default test vm 'vm-test'
USAGE

    log::ln "\nExamples:"
    log::subln "Build host: ${green}./${SCRIPT} build${none}"
    log::subln "Build given host: ${green}./${SCRIPT} build macbook${none}"
    log::subln "Build the test VM: ${green}./${SCRIPT} build vm${none}"
    log::subln "Build the prod1 VM: ${green}./${SCRIPT} build vm prod1${none}"
    log::subln "Clean build of test VM: ${green}./${SCRIPT} build vm -c${none}"
    log::subln "Build the installable ISO: ${green}./${SCRIPT} build iso${none}"
    log::subln "Build the installable ISO: ${green}./${SCRIPT} build iso xfce/base.nix${none}"
    echo
    exit
}

# Parse the build commands and execute
# --------------------------------------------------------------------------------------------------
build::run()
{
    utils::help "$@" zero "build::usage"

    # Process the given argument
    local arg=$1; shift
    case "$arg" in
        iso) build::iso "$@" ;;
        vm) build::vm "$@" ;;
        *) build::host "$arg" ;;
    esac
}

# Build the target host
# - $1 - the host name to target
# --------------------------------------------------------------------------------------------------
build::host()
{
    core::preamble

    # Use hostname as host
    HOST="$1"
    [[ "$1" == "" ]] && HOST="$(hostname)"

    # Target includes the prefix path
    TARGET="hosts/$HOST"

    log::header1 "Building ${cyan}${TARGET}${none}"
    flake::switch "$TARGET"
    trap flake::restore EXIT

    $SUDO nixos-rebuild dry-activate $TRACE $IMPURE --flake "${CONFIG_DIR}#${HOST}"
}


# Build the installable iso
# --------------------------------------------------------------------------------------------------
# https://releases.nixos.org/
# https://discourse.nixos.org/t/nixos-reproducible-builds-minimal-installation-iso-successfully-independently-rebuilt/34756
# - $1 - layer target to use e.g. 'base.nix'
# --------------------------------------------------------------------------------------------------
build::iso()
{
    core::preamble

    # Handle input target
    PROFILE="$1"
    [[ "$1" == "" ]] && PROFILE="base.nix"

    # Target includes the prefix path
    TARGET="layers/$PROFILE"

    log::header1 "Building installable ISO for ${cyan}${TARGET}${none}"
    flake::switch "$TARGET"
    trap flake::restore EXIT

    $SUDO nix build "${CONFIG_DIR}#nixosConfigurations.iso.config.system.build.isoImage"
}

# Build the vm
# - $1 - optional host name to target
# - $2 - optional no preamble flag
# --------------------------------------------------------------------------------------------------
build::vm()
{
    [[ $NO_PREAMBLE -eq 0 ]] && core::preamble

    if [[ "$1" == "hosts/"* ]]; then
        HOST="${1#hosts/}"
    else
        local host="${1#vm-}"  # trim vm- prefix
        [[ "$host" == "" ]] && host="test"
        HOST="vm-${host}"
    fi

    # Target includes the prefix path
    TARGET="hosts/$HOST"

    log::header1 "Building ${cyan}${TARGET}${none}"
    flake::switch "$TARGET"
    trap flake::restore EXIT

    # Optionally clean first
    if [[ $CLEAN -eq 1 ]]; then
        log::ls "Cleaning ${cyan}${HOST}${none}"
        $SUDO rm -rf "${CONFIG_DIR}/${HOST}"
    fi

    $SUDO nix build "${CONFIG_DIR}#nixosConfigurations.${HOST}.config.system.build.vm"

    # Install the vm in its own directory
    log::ls "Installing at ${cyan}./${HOST}${none}"
    $SUDO mkdir -p "${CONFIG_DIR}/${HOST}"
    [ -e result ] && mv -f result "${CONFIG_DIR}/${HOST}"

    build::seed_vm_key "$HOST"
}

# Seed the VM's 9p shared directory with the operator's sops age key
# - a freshly built VM root image has no /root/.config/sops/age/keys.txt and nothing runs
#   `clu init` inside a throwaway test VM, so sops-nix would have no key at activation time:
#   `setupSecrets` fails and nix-weave's `usersFromSecret` never creates the admin account,
#   leaving a VM you can't log into. guest.nix points `sops.age.keyFile` at /tmp/shared/keys.txt.
# - owned by the invoking user since the QEMU run script isn't run as root and the `shared`
#   virtfs uses security_model=none, i.e. host file ownership/modes apply verbatim in the guest
# - $VMDIR/shared and keys.txt are both gitignored, but note this does put the fleet's age
#   private key in the working tree for as long as the VM directory exists
# - $1 - hostname (hosts/<hostname> directory name)
# --------------------------------------------------------------------------------------------------
build::seed_vm_key()
{
    local hostname="$1"
    local shared="${CONFIG_DIR}/${hostname}/shared"
    local src

    for src in /root/.config/sops/age/keys.txt "${HOME}/.config/sops/age/keys.txt"; do
        $SUDO test -f "$src" && break
        src=""
    done

    if [[ -z "$src" ]]; then
        log::error "No sops age key found; ${cyan}${hostname}${none} won't be able to decrypt secrets"
        return 0
    fi

    log::ls "Seeding ${cyan}${shared}/keys.txt${none} from ${cyan}${src}${none}"
    $SUDO mkdir -p "$shared"
    $SUDO install -m 600 -o "$USER" "$src" "${shared}/keys.txt"
}
