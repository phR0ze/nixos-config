#!/usr/bin/env bash
#set -x

# Flake utility code
#
# ## Features
# - Decrypt and stage the build-time args a given machine needs at eval time
# --------------------------------------------------------------------------------------------------
HOST=""
PROFILE=""
TARGET=""

# Hostname whose args flake::switch last decrypted/staged, so flake::restore knows what to clean
# up without having to guess at the format of the caller's $HOST/$TARGET variables.
_FLAKE_ARGS_HOST=""

# Ensure the config path is accurate
flake::ensure_config_path()
{
    if [[ $(utils::cwd_is_nixos_config) -eq 1 ]]; then
        log::fatal "Config directory not detected, please run clu from config directory."
    fi
}

# Ensure target was given and exists
# - $1 - host or layer with preceding path prefix 'layers/' or 'hosts/'
#
# Example: flake::ensure_target hosts/homelab
# Example: flake::ensure_target layers/xfce/base
flake::ensure_target()
{
    local target="$1"

    # Check if the host name is missing
    if [[ "$target" == "" || "$target" == "hosts/" || "$target" == "layers/" ]]; then
        log::ls -n "Validating target ${cyan}${target}${none} was given..."
        log::status 1
    fi

    # Check that the given target name is valid
    log::ls -n "Validating target ${cyan}${target}${none} exists..."
    if [ ! -e "${CONFIG_DIR}/$target" ]; then
        log::status 1
    else
        log::status
    fi
}

# Switch flake target
# - Nix flakes only see git-tracked (or staged) files, so a host's encrypted args have to be
#   decrypted and staged before evaluation and cleaned up after (see flake::restore). This is now
#   the *only* staging clu does - host selection itself is a real `nixosConfigurations.<hostname>`
#   flake output, so nothing else needs to be staged or reverted.
# - $1 - host or layer with preceding path prefix 'layers/' or 'hosts/'
#
# Example: flake::switch hosts/homelab
flake::switch()
{
    local target="$1"
    flake::ensure_target "$target"

    # macbook's configuration.nix reads /lib/firmware/brcm directly off the host for its firmware
    # derivation, an absolute path outside the flake's source tree that pure evaluation can't see
    if [[ "$target" == "hosts/macbook" && -z "$IMPURE" ]]; then
        log::ls "${yellow}Warning: macbook requires the --impure flag to build, but it wasn't given${none}"
        utils::confirm_continue
    fi

    log::ls "Switching to target ${cyan}${target}${none}"
    utils::run pushd "${CONFIG_DIR}"

    # Only hosts have build-time args; layer-only targets (e.g. ISO builds) don't need this
    # and deliberately exclude secrets entirely. During install, args.dec.yaml is written directly
    # by install::install_config (not sops-decrypted), but still needs to be cleaned up by
    # flake::restore afterward, so track the host regardless of $INSTALL - just skip the actual
    # decrypt call in that case since there's nothing encrypted to decrypt yet.
    if [[ "$target" == hosts/* ]]; then
        _FLAKE_ARGS_HOST="${target#hosts/}"
        if [ $INSTALL -eq 0 ]; then
            flake::decrypt_args "$_FLAKE_ARGS_HOST"
            flake::decrypt_secrets "$_FLAKE_ARGS_HOST"
        fi
    fi

    utils::run popd
}

# Restore the decrypted args back to pristine in git and on disk
flake::restore()
{
    utils::run pushd "${CONFIG_DIR}"

    if [[ "$_FLAKE_ARGS_HOST" != "" ]]; then
        flake::restore_args "$_FLAKE_ARGS_HOST"
        flake::restore_secrets "$_FLAKE_ARGS_HOST"
        _FLAKE_ARGS_HOST=""
    fi

    utils::run popd
}

# Decrypt this host's build-time args (root args.enc.yaml + hosts/<hostname>/args.enc.yaml) and
# stage them so pure flake evaluation can see them.
# - a host with an empty hosts/<hostname>/.isolated marker file opts out of the root
#   args.enc.yaml entirely (see flake.nix's mergeArgs) - the root plaintext is never even
#   decrypted to disk for that host's build, not just excluded from the merge
# - assumes the caller has used pushd to switch directories for git to work correctly
# - $1 - hostname (hosts/<hostname> directory name)
flake::decrypt_args()
{
    local hostname="$1"
    local enc dec
    local files=("hosts/${hostname}/args.enc.yaml")

    [ -e "hosts/${hostname}/.isolated" ] || files=("args.enc.yaml" "${files[@]}")

    for enc in "${files[@]}"; do
        [ -e "$enc" ] || continue
        dec="${enc%.enc.yaml}.dec.yaml"
        log::d "Decrypting ${cyan}${enc}${none}"
        $SUDO bash -c "sops --decrypt '$enc' > '$dec'"
        utils::assert_forceable "$dec" || return 1
        $SUDO git add -f -- "$dec"
    done
}

# Remove this host's decrypted args from git and disk
# - assumes the caller has used pushd to switch directories for git to work correctly
# - $1 - hostname (hosts/<hostname> directory name)
flake::restore_args()
{
    local hostname="$1"
    local dec

    for dec in "args.dec.yaml" "hosts/${hostname}/args.dec.yaml"; do
        [ -e "$dec" ] || continue
        $SUDO git restore --staged -- "$dec" &>/dev/null || true
        $SUDO rm -f -- "$dec"
    done
}

# Merge this host's root + host-override secrets (see modules/default.nix's `host.sopsFile`) into
# a transient re-encrypted `hosts/<hostname>/secrets.merged.enc.yaml` and stage it so pure flake
# evaluation can see it.
# - unlike args, secrets stay sops-encrypted at rest, so root and host-override can't be merged as
#   plaintext attrsets at Nix eval time - this does the decrypt/merge/re-encrypt on the operator's
#   machine instead, exactly once per build, and flake::restore_secrets drops the result afterward
# - a no-op whenever the host has no override file (host.secrets then resolves straight to the
#   shared root secrets.enc.yaml, nothing to merge) or is `.isolated` (must never touch the fleet's
#   shared root secrets at all - see hosts/vps/.isolated)
# - assumes the caller has used pushd to switch directories for git to work correctly
# - $1 - hostname (hosts/<hostname> directory name)
flake::decrypt_secrets()
{
    local hostname="$1"
    local root="secrets.enc.yaml"
    local override="hosts/${hostname}/secrets.enc.yaml"
    local merged="hosts/${hostname}/secrets.merged.enc.yaml"
    local tmp

    [ -e "hosts/${hostname}/.isolated" ] && return 0
    [ -e "$override" ] || return 0
    [ -e "$root" ] || return 0

    log::d "Merging ${cyan}${root}${none} + ${cyan}${override}${none} -> ${cyan}${merged}${none}"

    tmp=$($SUDO mktemp)
    $SUDO chmod 600 "$tmp"

    # jq's `*` does the same recursive-merge-with-right-side-winning that lib.recursiveUpdate does
    # for args - yq here is the kislyuk/jq-based python wrapper (yq -y emits YAML instead of JSON)
    $SUDO bash -c "yq -s -y '.[0] * .[1]' <(sops --decrypt '$root') <(sops --decrypt '$override') > '$tmp'"

    $SUDO cp "$tmp" "$merged"
    $SUDO shred -u "$tmp"
    $SUDO sops --encrypt --in-place "$merged"
    utils::assert_forceable "$merged" || return 1
    $SUDO git add -f -- "$merged"
}

# Remove this host's transient merged secrets from git and disk
# - assumes the caller has used pushd to switch directories for git to work correctly
# - $1 - hostname (hosts/<hostname> directory name)
flake::restore_secrets()
{
    local hostname="$1"
    local merged="hosts/${hostname}/secrets.merged.enc.yaml"

    [ -e "$merged" ] || return 0
    $SUDO git restore --staged -- "$merged" &>/dev/null || true
    $SUDO rm -f -- "$merged"
}

# Cleanup trap function. Typically not used as the local functions will have their own which will
# call flake::restore directly
flake::trap()
{
    flake::restore
    exit 1
}

# Stage flake files for install or updates
# - files that the flake depends on must be git staged to be used.
# - $1 - host or layer to use for switching to the given target
#
# Example: flake::switch hosts/homelab
flake::stage_files()
{
    # Don't need to shutdown anything on a fresh install
    if [ $INSTALL -eq 0 ]; then
        log::ls -n "Shutting down ${cyan}xfconfd${none} to avoid conflicts..."
        pkill xfconfd 2>/dev/null || true
        log::status
    fi

    log::ls -n "Removing ${cyan}${ROOT_DIR}/nix/files.lock${none} to permit files update..."
    $SUDO rm -f "${ROOT_DIR}/nix/files.lock"
    log::status

    flake::switch $1

    if [ $INSTALL -eq 0 ]; then
        trap flake::unstage_files EXIT
    fi
}

# Remove the tempory flake files
# - files that the flake depends but don't want persisted
flake::unstage_files()
{
    flake::restore

    log::ls -n "Adding ${cyan}${ROOT_DIR}/nix/files.lock${none} to avoid updates during reboots..."
    $SUDO touch "${ROOT_DIR}/nix/files.lock"
    log::status
}
